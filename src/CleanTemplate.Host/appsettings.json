{
  "DatabaseProvider": "PostgreSql",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=cleantemplate;Username=postgres;Password=__SET_VIA_USER_SECRETS__"
  },
  "Caching": {
    "Provider": "Memory",
    "DefaultTtlSeconds": 300,
    "KeyPrefix": "CleanTemplate",
    "Redis": {
      "ConnectionString": "localhost:6379",
      "InstanceName": "CleanTemplate:"
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Policies": {
      "auth.login": {
        "PermitLimit": 5,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "auth.refresh": {
        "PermitLimit": 20,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "auth.logout": {
        "PermitLimit": 30,
        "WindowSeconds": 60,
        "QueueLimit": 0
      }
    }
  },
  "OpenTelemetry": {
    "ServiceName": "CleanTemplate.Host",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "grpc"
    },
    "Traces": {
      "Enabled": true,
      "SamplingRatio": 0.2
    },
    "Metrics": {
      "Enabled": true
    }
  },
  "Auth": {
    "Schemes": {
      "LocalJwt": {
        "Enabled": true,
        "Issuer": "CleanTemplate.Local",
        "Audience": "CleanTemplate.Api",
        "SigningKey": "",
        "ActiveSigningKeyId": "v1",
        "AccessTokenMinutes": 30,
        "RefreshTokenDays": 14,
        "AbsoluteSessionDays": 30
      },
      "Oidc": {
        "Enabled": false,
        "Provider": "EntraId",
        "AllowedTenantIds": [],
        "Authority": "https://login.microsoftonline.com/<tenantId>/v2.0",
        "Audience": "api://<clientId>",
        "Claims": {
          "Email": "email",
          "EmailVerified": "email_verified",
          "Name": "name",
          "Subject": "sub",
          "Groups": "groups",
          "Roles": "roles",
          "TenantId": "tid"
        }
      }
    },
    "Provisioning": {
      "Enabled": false,
      "RoleGrantLifetimeMinutes": 5,
      "DefaultRole": "User",
      "Admin": {
        "Emails": [ "admin@contoso.com" ],
        "Domains": [ "contoso.com" ],
        "Groups": [ "00000000-0000-0000-0000-000000000000" ],
        "Roles": [ "Admin" ]
      },
      "User": {
        "Groups": [],
        "Roles": [ "User" ]
      }
    },
    "RefreshTokenCleanup": {
      "Enabled": true,
      "IntervalMinutes": 60,
      "RevokedRetentionDays": 7
    }
  },
  "IdentitySeed": {
    "AdminEmail": "admin@local.template",
    "AdminPassword": "__SET_VIA_USER_SECRETS_ADMIN_PASSWORD__"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Microsoft.AspNetCore.Mvc": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
         "Microsoft.AspNetCore.HttpLogging": "Fatal",
         "Microsoft.EntityFrameworkCore": "Fatal",
        "System.Net.Http.HttpClient": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
